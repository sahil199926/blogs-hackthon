{
  "name": "my-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env-cmd -f .env.local next dev",
    "dev-prod": "env-cmd -f .env.production next dev",
    "dev-stg": "env-cmd -f .env.staging next dev",
    "build-prod": " GENERATE_SOURCEMAP=false env-cmd -f .env.production  next build",
    "build-stg": " GENERATE_SOURCEMAP=false  env-cmd -f .env.staging  next build",
    "build-test": " GENERATE_SOURCEMAP=false  env-cmd -f .env.test  next build",
    "build": "next build",
    "lint": "next lint",
    "format": "prettier --write .",
    "prepare": "husky install",
    "start": "next start"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": "eslint --fix",
    "**/*.{json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@next/third-parties": "^15.1.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-slot": "^1.1.1",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.5.1",
    "env-cmd": "^10.1.0",
    "lucide-react": "^0.469.0",
    "next": "14.2.20",
    "react": "^18",
    "react-archer": "^4.4.0",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "react-intersection-observer": "^9.14.1",
    "sharp": "^0.33.5",
    "swiper": "^11.2.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.20",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "postcss": "^8",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
